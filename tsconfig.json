{
  "compilerOptions": {
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "strict": true,
    "target": "es2022",
    "module": "node16",
    "lib": ["es2022"],
    "types": ["node"],
    "moduleResolution": "node16",
    "sourceMap": true,
    "esModuleInterop": true,
    "declaration": true,
    "composite": true
