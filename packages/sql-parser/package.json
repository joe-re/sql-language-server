{
  "author": "joe-re<joe.tialtngo@gmail.com>",
  "name": "@joe-re/sql-parser",
  "description": "sql parser for nodejs",
  "version": "1.7.0",
  "typings": "index.d.ts",
  "scripts": {
    "test": "vitest run",
    "build": "pnpm run generateParser && pnpm run generateFromClauseParser",
    "generateParser": "peggy -o ./base/parser.js parser.pegjs",
    "generateFromClauseParser": "peggy -o ./base/fromClauseParser.js  --allowed-start-rules extract_from_clause parser.pegjs"
  },
  "files": [
    "base",
    "index.js",
    "index.d.ts",
    "package.json",
    "LICENSE"
  ],
  "engines": {
    "node": "^22.13.0 || >=24"
  },
  "devDependencies": {
    "vitest": "~5.0.1",
    "peggy": "^5.1.0"
  },
  "readmeFilename": "README.md",
  "main": "index.js",
  "keywords": [
    "SQL",
    "Parer"
  ],
  "license": "GPLv2"
}
