{
  "name": "sql-language-server_vsc",
  "private": true,
  "version": "1.3.1",
  "main": "./out/extension",
  "author": "joe-re <joe.tialtngo@gmail.com>",
  "license": "MIT",
  "publisher": "joe-re",
  "scripts": {
    "compile": "esbuild ./extension.ts --bundle --platform=node --external:vscode --outfile=out/extension.js",
    "watch": "pnpm compile --watch",
    "typecheck": "tsc -p ."
  },
  "engines": {
    "vscode": "^1.91.0"
  },
  "activationEvents": [
    "onLanguage:sql",
    "onLanguage:python",
    "onNotebook:jupyter-notebook"
  ],
  "dependencies": {
    "vscode-languageclient": "^10.1.1"
  },
  "devDependencies": {
    "@types/node": "^22.18.0",
    "@types/vscode": "~1.91.0",
    "esbuild": "^0.28.2",
    "tslib": "^2.0.0",
    "typescript": "~6.0.3"
  }
}
