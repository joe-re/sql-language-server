{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "lib": [
      "es2022"
    ],
    "strict": false,
    "moduleResolution": "bundler",
    "esModuleInterop": true,
    "sourceMap": true,
    "outDir": "out",
    "types": [
      "node",
      "vscode"
    ],
    "noEmit": true
  },
  "exclude": [
    "node_modules",
    "out",
    ".vscode-test"
  ]
}
