{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "composite": false,
    "declaration": false,
    "noEmit": true,
    "skipLibCheck": true,
    "types": [
      "node",
      "vitest/globals"
    ]
  },
  "include": [
    "bin",
    "src",
    "test",
    "package.json"
  ],
  "exclude": [
    "node_modules",
    "dist"
  ]
}
